# 이 파일을 복사해 .env.local 을 만들고 값을 채운다. (.env.local 은 GitHub에 올라가지 않음)
# 값은 Supabase 화면 > Project Settings > API 에서 확인한다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 관리자 열쇠: 절대 다른 사람에게 보여주거나 코드에 쓰지 않는다
SUPABASE_SERVICE_ROLE_KEY=
# 서비스 주소 (메일 속 링크에 쓰임)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
